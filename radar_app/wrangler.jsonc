{
  "name": "velora-radar",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews_enabled": false,
  "observability": {
    "enabled": true
  }
}
