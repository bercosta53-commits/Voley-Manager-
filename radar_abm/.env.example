# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# Onde fica o banco (arquivo único SQLite). Padrão: dados/radar.db
RADAR_DB=dados/radar.db
# Pasta dos logs. Padrão: logs/
RADAR_LOGS=logs

# Fase 2: conector CNPJ. Na primeira coleta, entradas no QSA mais novas que isto viram sinal.
RADAR_CNPJ_JANELA_DIAS=180

# Fase 3: notícias. Quantos dias para trás a busca olha.
RADAR_NOTICIAS_JANELA_DIAS=30

# Vagas: em quais plataformas o radar procura sozinho a página de carreiras da conta (Gupy e Greenhouse
# permitem conferir o nome da empresa). As outras entram por "vagas pagina(s)".
RADAR_VAGAS_ADIVINHAR=gupy,greenhouse

# Fase 4: Apollo (comitê de compra). Chave em Apollo > Settings > Integrations > API.
APOLLO_API_KEY=
# Cada pessoa do comitê é consultada no máximo uma vez a cada N dias (1 crédito por pessoa encontrada).
RADAR_APOLLO_INTERVALO_DIAS=30
# Teto de créditos por execução; o que passar fica para a próxima, decisores primeiro.
RADAR_APOLLO_MAX_CREDITOS=25

# Fase 5: classificador com Claude. Chave em console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
# Modelo do classificador. Padrão: claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
# Outro arquivo de taxonomia (padrão: sinais.yaml na pasta do projeto).
# RADAR_TAXONOMIA=sinais.yaml

# Bibliotecas de anúncios. Caminho gratuito (padrão): Google pelo SerpApi, Meta pelo Apify.
RADAR_ANUNCIOS_PROVEDOR=gratuito
SERPAPI_API_KEY=
APIFY_TOKEN=
RADAR_SERPAPI_LIMITE_MES=250
RADAR_APIFY_LIMITE_USD_MES=5
RADAR_APIFY_CUSTO_ANUNCIO_USD=0.00075
RADAR_APIFY_MAX_ANUNCIOS_PAGINA=30
RADAR_ANUNCIOS_MAX_DETALHES=2
RADAR_ANUNCIOS_INTERVALO_DIAS=7
# Alternativa paga (RADAR_ANUNCIOS_PROVEDOR=searchapi): Google e Meta com uma chave, US$ 40/mês por 10.000 buscas.
SEARCHAPI_API_KEY=
RADAR_ANUNCIOS_CUSTO_BUSCA_USD=0.004
