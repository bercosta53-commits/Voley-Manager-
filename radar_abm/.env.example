# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# Onde fica o banco (arquivo único SQLite). Padrão: dados/radar.db
RADAR_DB=dados/radar.db
# Pasta dos logs. Padrão: logs/
RADAR_LOGS=logs

# Fase 4: Apollo (comitê de compra). Chave em Apollo > Settings > Integrations > API.
APOLLO_API_KEY=

# Fase 5: classificador com Claude. Chave em console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
